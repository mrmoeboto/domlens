{
  "name": "domlens.js",
  "title": "domlens",
  "version": "0.1.0",
  "description": "Fast, high-fidelity DOM-to-image capture for the browser. Dual-engine (SVG foreignObject with a canvas-repaint fallback) successor to html2canvas.",
  "keywords": [
    "screenshot",
    "html2canvas",
    "dom-to-image",
    "canvas",
    "svg",
    "foreignobject",
    "rasterize",
    "capture",
    "screen-capture",
    "html-to-image",
    "png",
    "browser"
  ],
  "license": "MIT",
  "author": {
    "name": "Moe Loubani",
    "email": "moe@moe.ca",
    "url": "https://github.com/mrmoeboto"
  },
  "homepage": "https://supportshot.com/domlens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmoeboto/domlens.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mrmoeboto/domlens/issues"
  },
  "type": "commonjs",
  "main": "dist/domlens.js",
  "module": "dist/domlens.esm.js",
  "browser": "dist/domlens.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "unpkg": "dist/domlens.min.js",
  "jsdelivr": "dist/domlens.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/domlens.esm.js",
      "require": "./dist/domlens.js",
      "default": "./dist/domlens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.mjs && tsc -p tsconfig.build.json",
    "watch": "rollup -c rollup.config.mjs -w",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "css-line-break": "^2.1.0",
    "text-segmentation": "^1.0.3"
  }
}
