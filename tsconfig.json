{
    "compilerOptions": {
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "types": ["node"],
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2020", "dom"],
        "sourceMap": true,
        "resolveJsonModule": true,
        "noEmit": true,
        // Source-based workspace resolution for typecheck/unit tests; package builds
        // override this (paths: {}) to resolve through node_modules to built artifacts.
        "paths": {
            "domlens.js": ["./packages/core/src/index.ts"]
        }
    },
    "include": ["packages/core/src", "packages/html2canvas-compat/src"]
}
