{
  "name": "domlens-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "domlens \u2014 fast, high-fidelity DOM-to-image capture for the browser; successor to html2canvas.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmoeboto/domlens.git"
  },
  "bugs": {
    "url": "https://github.com/mrmoeboto/domlens/issues"
  },
  "scripts": {
    "build": "npm run build --workspace=domlens && npm run build --workspace=domlens-html2canvas",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages",
    "format": "prettier --write \"{packages/*/src,tests,scripts}/**/*.ts\"",
    "test": "npm run lint && npm run typecheck && npm run unittest && npm run reftests",
    "unittest": "vitest run",
    "reftests": "playwright test",
    "bench": "tsx tests/bench/build-vendor.ts && playwright test --config=playwright.bench.config.ts",
    "watch": "npm run watch --workspace=domlens",
    "start": "tsx tests/server.ts --port=8080 --cors=8081"
  },
  "homepage": "https://github.com/mrmoeboto/domlens#readme",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "@zumer/snapdom": "^2.12.8",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.2",
    "html-to-image": "^1.11.13",
    "html2canvas-proxy": "^1.0.1",
    "html2canvas-v1": "npm:html2canvas@^1.4.1",
    "jsdom": "^29.1.1",
    "modern-screenshot": "^4.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "serve-index": "^1.9.2",
    "ssim.js": "^3.5.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "yargs": "^18.0.0"
  },
  "author": {
    "name": "Moe Loubani",
    "email": "moe@moe.ca",
    "url": "https://github.com/mrmoeboto"
  }
}
