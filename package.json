{
  "name": "html2canvas-monorepo",
  "private": true,
  "version": "1.4.1",
  "description": "Screenshots with JavaScript",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:niklasvh/html2canvas.git"
  },
  "bugs": {
    "url": "https://github.com/niklasvh/html2canvas/issues"
  },
  "scripts": {
    "build": "npm run build --workspace=@domlens/core",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages",
    "format": "prettier --write \"{packages/*/src,tests,scripts}/**/*.ts\"",
    "test": "npm run lint && npm run typecheck && npm run unittest && npm run reftests",
    "unittest": "vitest run",
    "reftests": "playwright test",
    "watch": "npm run watch --workspace=@domlens/core",
    "start": "tsx tests/server.ts --port=8080 --cors=8081"
  },
  "homepage": "https://html2canvas.hertzen.com",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.2",
    "html2canvas-proxy": "^1.0.1",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "serve-index": "^1.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "yargs": "^18.0.0"
  }
}
